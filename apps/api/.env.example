# Local development only. Never point this file at production.
# Copy to apps/api/.env on your machine. Production uses a VPS-only .env
# that is never committed: /srv/apps/takiia/apps/api/.env

NODE_ENV=development
HOST=127.0.0.1
PORT=3033

# Development database — create this locally. Do not use takiia_db / takiia_app
# production credentials here.
DATABASE_URL=postgresql://takiia_dev:CHANGE_ME_LOCAL_PASSWORD@127.0.0.1:5432/takiia_dev

# 32+ random bytes. Generate locally; do not reuse production values.
SESSION_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_STRING
CSRF_SECRET=CHANGE_ME_GENERATE_ANOTHER_LONG_RANDOM_STRING

WEB_ORIGIN=http://127.0.0.1:3034
COOKIE_DOMAIN=
COOKIE_SECURE=false

# Feature flags — keep false until the provider is configured and tested.
PAYMENTS_ENABLED=false
EMAIL_DELIVERY_ENABLED=false
SOCIAL_PUBLISH_ENABLED=false
WEBRTC_CALLS_ENABLED=false
LIVEKIT_MEETINGS_ENABLED=false
GOOGLE_ADS_ENABLED=false

# Optional providers. Leave empty when unused. Never commit real values.
STRIPE_SECRET_KEY=
SMTP_URL=
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
